# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=4000

# --- Database -------------------------------------------------------------
# Supabase: Project -> Connect -> ORMs -> Prisma gives you both lines.
#   DATABASE_URL = pooled connection (port 6543, ends with ?pgbouncer=true)
#   DIRECT_URL   = direct/session connection (port 5432), used for migrations
# Local docker-compose: use the same URL for both:
#   postgresql://ticketing:ticketing@localhost:5432/ticketing
DATABASE_URL=
DIRECT_URL=
# Tables live in this Postgres schema (not "public", which Supabase exposes
# through its Data API). Tests use <DB_SCHEMA>_test automatically.
DB_SCHEMA=ticketing

# --- Redis (needed from Phase 4: WhatsApp send queue) -----------------------
REDIS_URL=

# --- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
QR_SECRET=
SESSION_SECRET=

# --- Web --------------------------------------------------------------------
# Public address of the site, used in pass links sent over WhatsApp.
PUBLIC_BASE_URL=http://localhost:3000
# Where the Next.js server reaches the API (it proxies /api/* there).
API_INTERNAL_URL=http://localhost:4000
# Number of reverse proxies in front of the API (Next.js proxy = 1).
TRUST_PROXY=1
ADMIN_SESSION_HOURS=12

# --- WhatsApp Cloud API (Phase 4) -------------------------------------------
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# --- Seed (npm run seed) ----------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
# Leave empty to have the seed script generate and print a password.
SEED_ADMIN_PASSWORD=

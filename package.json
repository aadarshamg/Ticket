{
  "name": "event-ticketing",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "test": "npm run test -w apps/api",
    "test:unit": "npm run test:unit -w apps/api",
    "test:integration": "npm run test:integration -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api --",
    "db:deploy": "npm run db:deploy -w apps/api",
    "seed": "npm run seed -w apps/api --",
    "create-admin": "npm run create-admin -w apps/api --"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "overrides": {
    "vite": "^7.3.7"
  }
}
